{
  "name": "obsidian-compute",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "test": "node --test backend/tests/pricing.test.js",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write \"backend/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"worker/*.js\" \"tests/**/*.js\" \"scripts/*.mjs\" \"*.{json,yaml,js}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
